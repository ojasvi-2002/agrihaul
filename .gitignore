# ============================================================
# AgriHaul .gitignore
# ============================================================
# IMPORTANT: config.js contains your API keys (Twilio, Google
# Sheets URLs). This file must NEVER be pushed to GitHub.
# Always use config.example.js as the template for new setups.
# ============================================================

# API keys — never commit this
#js/config.js

# OS files
#.DS_Store
#Thumbs.db

# Editor folders
#.vscode/
#.idea/

# Node (if you ever add a build step)
#node_modules/
#package-lock.json


# AgriHaul .gitignore
# ============================================================
# js/config.js is now safe to commit — Twilio credentials moved
# to Apps Script Script Properties during the security audit and
# are no longer stored here. What remains (Supabase anon key,
# published Google Sheets CSV URLs, the Apps Script write URL) is
# either designed to be public or already protected server-side
# by Code.gs's requireRole() check. Committing it is required for
# static hosts like GitHub Pages, which only serve tracked files.
# ============================================================

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Node — used by frontend/ and backend/
node_modules/
dist/
*.tsbuildinfo

# Environment files with real secrets. .env.example (committed) documents
# the required keys; backend/.env and frontend/.env hold real local values.
.env
.env.local
!.env.example

# Note: package-lock.json is intentionally NOT ignored for frontend/ and
# backend/ — lockfiles should be committed so installs are reproducible.

# Raw data exports for scripts/importFarmersFromCsv.ts and similar
# migration scripts (CLAUDE.md §36) — these can contain real farmer PII
# once migrating actual production data, never just test/demo CSVs.
*.csv
