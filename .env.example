# ============================================================
# AgriHaul — environment variable reference
# ============================================================
# This file is committed and documents what each app needs.
# Actual values live in backend/.env and frontend/.env, which
# are gitignored and never committed.
# ============================================================

# ---- backend/.env ----
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://agrihaul:agrihaul@localhost:5432/agrihaul
# From console.twilio.com's dashboard "Account Info" panel (SID starts
# "AC", click "Show" to reveal the auth token — handle it like a password).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Console -> Phone Numbers -> Manage -> Active Numbers. E.164 format,
# e.g. +15551234567. A trial account's inbound SMS only works from
# numbers added under Phone Numbers -> Verified Caller IDs.
TWILIO_PHONE_NUMBER=
# Public URL this backend is reachable at (e.g. https://api.example.com).
# Twilio can't reach localhost directly — for local testing, tunnel with
# `ngrok http 3000` and point the number's "A MESSAGE COMES IN" webhook
# (Console -> Phone Numbers -> your number -> Messaging Configuration) at
# https://<subdomain>.ngrok-free.app/webhooks/twilio/incoming (POST).
# Only strictly required in production so Twilio can call back
# /webhooks/twilio/status.
PUBLIC_BASE_URL=
# Number of reverse-proxy hops in front of this process (0 = none, the
# correct default for local dev). Only set this — to the *exact* hop
# count, typically 1 for a single load balancer/PaaS — when actually
# deployed behind a proxy. Setting it higher than the real number of
# hops lets a client forge X-Forwarded-For and bypass the IP-based rate
# limits on login/signup.
TRUST_PROXY_HOPS=0
AUTH_SECRET=

# ---- frontend/.env ----
VITE_API_URL=http://localhost:3000
